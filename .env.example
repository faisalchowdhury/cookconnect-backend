NODE_ENV=development
PORT=6000
MONGODB_URI=mongodb://localhost:27017/cookconnect
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30
CORS_ORIGINS=http://localhost:6003,http://localhost:6001
COOKIE_SECURE=false
UPLOAD_DIR=./uploads
STORAGE_DRIVER=local
# R2 / S3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
# Email
# MAIL_DRIVER: console | smtp | resend | gmail
MAIL_DRIVER=console
MAIL_FROM=CookconneKt <noreply@cookconnect.ma>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
# Used when MAIL_DRIVER=gmail (Gmail address + a 16-char App Password, not your login password)
Nodemailer_GMAIL=
Nodemailer_GMAIL_PASSWORD=
# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:6000/api/v1/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:6000/api/v1/auth/facebook/callback
FRONTEND_URL=http://localhost:6003
DASHBOARD_URL=http://localhost:6001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
